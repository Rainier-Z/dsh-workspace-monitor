{
  "name": "dsh-monitor",
  "version": "0.1.0",
  "description": "Polling workspace monitor plugin for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./scanner": "./lib/scanner.js",
    "./monitor": "./lib/monitor.js"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/scanner.js && node --check lib/monitor.js",
    "test": "node --test && node scripts/validate-package.js",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.4.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": ">=0.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
