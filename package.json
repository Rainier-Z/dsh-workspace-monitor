{
    "name":  "dsh-workspace-monitor",
    "version":  "0.2.0",
    "description":  "Session-owned durable workspace monitor plugin for DeepSeek Harness Desktop",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./scanner":  "./lib/scanner.js",
                    "./monitor":  "./lib/monitor.js"
                },
    "files":  [
                  "index.js",
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "check":  "node --check index.js \u0026\u0026 node --check lib/controller.js \u0026\u0026 node --check lib/delivery.js \u0026\u0026 node --check lib/domain.js \u0026\u0026 node --check lib/monitor.js \u0026\u0026 node --check lib/runtime.js \u0026\u0026 node --check lib/scanner.js \u0026\u0026 node --check lib/scheduler.js \u0026\u0026 node --check lib/task-service.js \u0026\u0026 node --check lib/task-store.js \u0026\u0026 node --check lib/tools.js",
                    "test":  "node --test \u0026\u0026 node scripts/validate-package.js",
                    "pack:check":  "npm pack --dry-run",
                    "prepack":  "node scripts/validate-package.js"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-agent":  ">=0.1.7-rc.2 <0.1.8-0",
                             "@deepseek-ai/dsh-llm":  ">=0.1.7-rc.2 <0.1.8-0",
                             "@deepseek-ai/dsh-storage-domain":  ">=0.1.7-rc.2 <0.1.8-0",
                             "@deepseek-ai/dsh-tools":  ">=0.1.7-rc.2 <0.1.8-0",
                             "@deepseek-ai/schemastery":  "^3.18.1",
                             "zod":  "^4.4.3"
                         },
    "engines":  {
                    "node":  "^22.19.0 || >=24.0.0"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Rainier-Z/dsh-workspace-monitor.git"
                   },
    "homepage":  "https://github.com/Rainier-Z/dsh-workspace-monitor#readme",
    "bugs":  {
                 "url":  "https://github.com/Rainier-Z/dsh-workspace-monitor/issues"
             }
}
